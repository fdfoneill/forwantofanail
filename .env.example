APP_ENV=development
SCENARIO_DIR=/absolute/path/to/copper-coast
DATABASE_URL=postgresql+psycopg://forwantofanail:development-only@127.0.0.1:55432/forwantofanail
ADMIN_TOKEN=replace-with-a-long-random-secret
GAME_PASSWORD=replace-with-a-shared-game-password
SESSION_SECRET=replace-with-an-independent-long-random-secret
PUBLIC_ORIGIN=http://127.0.0.1:8000

# Optional LLM commander providers. A profile is unavailable until its model
# variable (and, for OpenAI, API key) is configured.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_AGENT_MODEL=
AGENT_TOOL_API_BASE_URL=http://127.0.0.1:8000
